<Window x:Class="DeployAssistant.View.CheckoutGateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeployAssistant.View"
        mc:Ignorable="d"
        Title="{DynamicResource S.Win.CheckoutGate}"
        Height="500" Width="760"
        MinHeight="380" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Headline switches between the clean and the dirty wording (code-behind) -->
        <TextBlock Grid.Row="0"
                   x:Name="HeadlineText"
                   FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   x:Name="DetailText"
                   Margin="0,6,0,10"
                   FontSize="{StaticResource FsBody}" Foreground="#555555"
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3">
            <Grid>
                <!-- Local modifications that a checkout would overwrite -->
                <DataGrid x:Name="ModificationList"
                          IsReadOnly="True"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          AutoGenerateColumns="False"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{StaticResource S.ColState}"        Binding="{Binding DataState}"    Width="150"/>
                        <DataGridTextColumn Header="{StaticResource S.ColFilename}"     Binding="{Binding DataName}"     Width="150"/>
                        <DataGridTextColumn Header="{StaticResource S.ColRelativePath}" Binding="{Binding DataRelPath}"  Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Shown instead of the grid when the working directory is clean -->
                <TextBlock x:Name="CleanText"
                           Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{StaticResource FsBody}" Foreground="#388E3C"
                           Text="{DynamicResource S.Gate.NoLocalMods}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Deliberately NOT IsDefault: on the dirty path this button discards work. -->
            <Button x:Name="ProceedButton"
                    Click="Proceed_Click"
                    MinWidth="260" Height="30" Margin="0,0,8,0"
                    FontSize="{StaticResource FsBody}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button x:Name="CancelButton"
                    Content="{DynamicResource S.Cancel}"
                    IsCancel="True" IsDefault="True"
                    MinWidth="100" Height="30"
                    FontSize="{StaticResource FsBody}"
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
