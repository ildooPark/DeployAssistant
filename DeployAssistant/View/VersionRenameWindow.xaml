<Window x:Class="DeployAssistant.View.VersionRenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeployAssistant.View"
        mc:Ignorable="d"
        Title="{DynamicResource S.Win.RenameVersion}"
        Height="360" Width="560"
        MinHeight="300" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeadlineText"
                   FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,10"
                   FontSize="{StaticResource FsBody}" Foreground="#555555"
                   TextWrapping="Wrap"
                   Text="{DynamicResource S.Ren.Explain}"/>

        <TextBlock Grid.Row="2" Style="{StaticResource HeaderLabelStyle}" Margin="0,0,0,2" Text="{DynamicResource S.Ren.VersionName}"/>
        <TextBox Grid.Row="3"
                 x:Name="VersionNameBox"
                 FontSize="{StaticResource FsBody}" Padding="4,3"
                 BorderBrush="#CDCDCD" BorderThickness="1"/>

        <TextBlock Grid.Row="4" Style="{StaticResource HeaderLabelStyle}" Margin="0,10,0,2" Text="{DynamicResource S.UpdateLog}"/>
        <TextBox Grid.Row="5"
                 x:Name="UpdateLogBox"
                 FontSize="{StaticResource FsBody}" Padding="4,3"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 BorderBrush="#CDCDCD" BorderThickness="1"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="6" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ApplyButton"
                    Content="{DynamicResource S.Apply}"
                    Click="Apply_Click"
                    IsDefault="True"
                    MinWidth="110" Height="30" Margin="0,0,8,0"
                    FontSize="{StaticResource FsBody}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button x:Name="CancelButton"
                    Content="{DynamicResource S.Cancel}"
                    IsCancel="True"
                    MinWidth="100" Height="30"
                    FontSize="{StaticResource FsBody}"
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
