<Window x:Class="DeployAssistant.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeployAssistant.View"
        mc:Ignorable="d"
        Title="Deploy Assistant" Height="900" Width="1600"
        MinHeight="700"
        MinWidth="1100"
        Icon="/app.ico">

    <Window.Resources>
        <!-- StateBadgeStyle — uses MetaDataVM.CurrentMetaDataState binding unique to MainWindow -->
        <Style x:Key="StateBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#757575"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="Processing">
                    <Setter Property="Background" Value="#1976D2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="Initializing">
                    <Setter Property="Background" Value="#1976D2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="Updating">
                    <Setter Property="Background" Value="#1976D2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="Retrieving">
                    <Setter Property="Background" Value="#1976D2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="Reverting">
                    <Setter Property="Background" Value="#F57C00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="Exporting">
                    <Setter Property="Background" Value="#7B1FA2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="IntegrityChecking">
                    <Setter Property="Background" Value="#0097A7"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MetaDataVM.CurrentMetaDataState}" Value="Idle">
                    <Setter Property="Background" Value="#388E3C"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F7F7F7" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
              FontSize="{StaticResource FsBody}" Padding="2,1">
            <MenuItem x:Name="ProjectMenu" Header="{DynamicResource S.Menu.Project}"
                      SubmenuOpened="ProjectMenu_SubmenuOpened">
                <MenuItem Header="{DynamicResource S.Menu.OpenDest}" Command="{Binding MetaDataVM.GetProject}"/>
                <MenuItem Header="{DynamicResource S.Menu.SetSource}" Command="{Binding FileTrackVM.GetDeploySrcDir}"/>
                <Separator/>
                <MenuItem x:Name="RecentProjectsMenu" Header="{DynamicResource S.Menu.Recent}">
                    <MenuItem Header="{DynamicResource S.Menu.NoRecent}" IsEnabled="False"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource S.Menu.Exit}" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem x:Name="SettingsMenu" Header="{DynamicResource S.Menu.Settings}"
                      SubmenuOpened="SettingsMenu_SubmenuOpened">
                <MenuItem Header="{DynamicResource S.Menu.FastCheckPercent}"
                          ToolTip="{DynamicResource S.Menu.FastCheckTooltip}">
                    <MenuItem x:Name="Sample100" Header="100%" Tag="100" Click="SamplePercent_Click"/>
                    <MenuItem x:Name="Sample50"  Header="50%"  Tag="50"  Click="SamplePercent_Click"/>
                    <MenuItem x:Name="Sample25"  Header="25%"  Tag="25"  Click="SamplePercent_Click"/>
                    <MenuItem x:Name="Sample10"  Header="10%"  Tag="10"  Click="SamplePercent_Click"/>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ═══════════════════════════════════════════════════════
             Header ToolBar
        ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Primary action buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="IntegrityCheckButton"
                            Margin="4,2"
                            Padding="10,5"
                            FontSize="{StaticResource FsBody}"
                            Content="{DynamicResource S.IntegrityCheck}"
                            Command="{Binding FileTrackVM.CheckProjectIntegrity}"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                    <Button x:Name="CheckoutButton"
                            Margin="4,2"
                            Padding="10,5"
                            FontSize="{StaticResource FsBody}"
                            Content="{DynamicResource S.Checkout}"
                            ToolTip="{DynamicResource S.CheckoutTooltip}"
                            Command="{Binding BackupVM.CheckoutBackup}"
                            Style="{StaticResource ToolbarButtonStyle}"/>
                </StackPanel>

                <!-- Project info -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock VerticalAlignment="Center" Foreground="#616161" FontSize="{StaticResource FsBody}">
                        <Run Text="{DynamicResource S.ProjectLabel}"/>
                        <Run Text="{Binding MetaDataVM.ProjectName}" FontWeight="Bold" Foreground="#212121"/>
                    </TextBlock>
                    <TextBlock Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#616161" FontSize="{StaticResource FsBody}">
                        <Run Text="{DynamicResource S.VersionLabel}"/>
                        <Run Text="{Binding MetaDataVM.CurrentVersion}" FontWeight="Bold" Foreground="#00796B"/>
                    </TextBlock>
                </StackPanel>

                <!-- Language + state badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="LanguageSelect"
                              Width="82" Margin="4,0"
                              VerticalAlignment="Center"
                              FontSize="{StaticResource FsBody}"
                              SelectionChanged="LanguageSelect_SelectionChanged">
                        <ComboBoxItem Content="한국어" Tag="ko-KR"/>
                        <ComboBoxItem Content="English" Tag="en-US"/>
                    </ComboBox>
                    <Border CornerRadius="4" Padding="8,3"
                            VerticalAlignment="Center" Margin="4,0"
                            Style="{StaticResource StateBadgeStyle}">
                        <TextBlock Text="{Binding MetaDataVM.CurrentMetaDataState}"
                                   FontSize="{StaticResource FsBody}" Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             Workspace — History/DiffLog | Tabs | Staging/Actions
        ════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="330" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Version History (top) + Diff Log (bottom) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.45*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="0.55*"/>
                </Grid.RowDefinitions>

                <!-- Version History -->
                <DockPanel Grid.Row="0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}">
                        <DockPanel>
                            <!-- Re-reads the stored version list (BackupVM.FetchBackup) -->
                            <Button DockPanel.Dock="Right"
                                    Content="⟳"
                                    ToolTip="{DynamicResource S.RefreshHistoryTooltip}"
                                    Command="{Binding BackupVM.FetchBackup}"
                                    Width="22" Height="18" Padding="0"
                                    FontSize="{StaticResource FsBody}"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <TextBlock Style="{StaticResource HeaderLabelStyle}" Margin="0"
                                       VerticalAlignment="Center" Text="{DynamicResource S.VersionHistory}"/>
                        </DockPanel>
                    </Border>
                    <ListView x:Name="backupList"
                              ItemsSource="{Binding BackupVM.BackupProjectDataList}"
                              SelectedItem="{Binding BackupVM.SelectedItem}"
                              Tag="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
                              BorderBrush="#CDCDCD"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{StaticResource S.ColRev}"     DisplayMemberBinding="{Binding RevisionNumber}"                                  Width="35"/>
                                <GridViewColumn Header="{StaticResource S.ColVersion}" DisplayMemberBinding="{Binding UpdatedVersion}"                                  Width="190"/>
                                <GridViewColumn Header="{StaticResource S.ColDate}"    DisplayMemberBinding="{Binding UpdatedTime, StringFormat={}{0:yyyy-MM-dd}}"      Width="85"/>
                                <GridViewColumn Header="{StaticResource S.ColBy}"      DisplayMemberBinding="{Binding UpdaterName}"                                     Width="55"/>
                                <GridViewColumn Header="Δ"       DisplayMemberBinding="{Binding NumberOfChanges}"                                 Width="28"/>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProjectMain}" Value="True">
                                        <Setter Property="Background" Value="#C8E6C9"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource S.ExportFullVersion}"       Command="{Binding BackupVM.ExportVersion}"/>
                                <MenuItem Header="{DynamicResource S.ExportVersionLog}"        Command="{Binding BackupVM.ExtractVersionLog}"/>
                                <MenuItem Header="{DynamicResource S.CompareWithMain}"         Command="{Binding BackupVM.CompareDeployedProjectWithMain}"/>
                                <MenuItem Header="{DynamicResource S.CompareSrcWithMain}"     Command="{Binding FileTrackVM.CompareDeployedProjectWithMain}"/>
                                <MenuItem Header="{DynamicResource S.Checkout}"                  Command="{Binding BackupVM.CheckoutBackup}"/>
                                <MenuItem Header="{DynamicResource S.FullLog}"                  Command="{Binding BackupVM.ViewFullLog}"/>
                                <MenuItem Header="{DynamicResource S.SrcFullLog}"              Command="{Binding FileTrackVM.GetDeployedProjectInfo}"/>
                                <MenuItem Header="{DynamicResource S.SrcVersionSimilarities}"  Command="{Binding FileTrackVM.SrcSimilarityWithBackups}"/>
                                <Separator/>
                                <MenuItem Header="{DynamicResource S.RenameRetag}"          Command="{Binding BackupVM.RenameVersion}"/>
                                <MenuItem Header="{DynamicResource S.DeleteVersion}"           Command="{Binding BackupVM.DeleteVersion}"
                                          Foreground="#C62828"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="#E0E0E0"/>

                <!-- Version Log (selected version's summary + changed files) -->
                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Style="{StaticResource HeaderLabelStyle}" Margin="0" Text="{DynamicResource S.VersionLog}"/>
                    </Border>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1" Padding="8,5">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" FontSize="{StaticResource FsCaption}" Foreground="#757575"
                                               VerticalAlignment="Center"
                                               Text="{Binding BackupVM.SelectedItem.UpdatedTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                                    <TextBlock FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#212121"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding BackupVM.SelectedItem.UpdatedVersion}"/>
                                </DockPanel>
                                <TextBlock FontSize="{StaticResource FsCaption}" Foreground="#757575" Margin="0,1,0,0">
                                    <Run Text="{DynamicResource S.ByPrefix}"/><Run Text="{Binding BackupVM.UpdaterName, Mode=OneWay}"/>
                                </TextBlock>
                                <ScrollViewer MaxHeight="52" Margin="0,3,0,0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <TextBlock FontSize="{StaticResource FsBody}" Foreground="#424242" TextWrapping="Wrap"
                                               Text="{Binding BackupVM.UpdateLog}"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <DataGrid Grid.Row="1"
                                  x:Name="DiffLog"
                                  ItemsSource="{Binding BackupVM.DiffLog}"
                                  IsReadOnly="True"
                                  BorderBrush="#CDCDCD"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  RowHeight="22"
                                  FontSize="{StaticResource FsBody}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource S.ColFilename}"  Binding="{Binding FileName}"        Width="3*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColBuildV}"   Binding="{Binding DstBuildVersion}" Width="2*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColPrevV}"    Binding="{Binding SrcBuildVersion}" Width="2*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColProjectV}" Binding="{Binding DeployedV}"       Width="2*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColHash}"      Binding="{Binding DstHash}"         Width="1.5*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColState}"     Binding="{Binding DataState}"       Width="1.5*"/>
                                <DataGridTemplateColumn Header="{StaticResource S.Restore}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{DynamicResource S.Restore}"
                                                    Command="{Binding DataContext.FileTrackVM.AddForRestore,
                                                        RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                    CommandParameter="{Binding RestoreTarget}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Added">
                                            <Setter Property="Background">
                                                <Setter.Value><SolidColorBrush Color="LightGreen" Opacity="0.4"/></Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Deleted">
                                            <Setter Property="Background">
                                                <Setter.Value><SolidColorBrush Color="LightCoral" Opacity="0.4"/></Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Modified">
                                            <Setter Property="Background">
                                                <Setter.Value><SolidColorBrush Color="Khaki" Opacity="0.35"/></Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#E0E0E0"/>

            <!-- CENTER: Project Files / Metafile Compare tabs -->
            <TabControl Grid.Column="2" BorderBrush="#CDCDCD">
                <TabItem Header="{DynamicResource S.ProjectFiles}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox Grid.Row="0"
                                 x:Name="FileFilterKeyword"
                                 TextChanged="FileFilterKeyword_TextChanged"
                                 Height="28"
                                 VerticalAlignment="Center"
                                 Margin="6,4"
                                 FontSize="{StaticResource FsBody}"
                                 BorderThickness="1"
                                 BorderBrush="#E0E0E0"/>
                        <DataGrid Grid.Row="1"
                                  x:Name="ProjectMainFileList"
                                  ItemsSource="{Binding MetaDataVM.ProjectFiles}"
                                  IsReadOnly="True"
                                  BorderBrush="#CDCDCD"
                                  AlternatingRowBackground="#FAFAFA"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F0F0F0"
                                  RowHeight="24"
                                  FontSize="{StaticResource FsBody}"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{StaticResource S.ColFilename}"      Binding="{Binding DataName}"                Width="1.4*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColRelativePath}" Binding="{Binding DataRelPath}"             Width="3*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#616161"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="{StaticResource S.ColBuildV}"       Binding="{Binding VersionDisplay}"          Width="2*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColDeployedV}"    Binding="{Binding DeployedProjectVersion}"  Width="1.4*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColUpdated}"       Binding="{Binding UpdatedTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.2*"/>
                                <DataGridTextColumn Header="{StaticResource S.ColHash}"          Binding="{Binding DataHash}"                Width="1*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- ═════════════════════════════════════════════════════
                     Metafile Compare tab
                     Drop a .VersionLog here to auto-diff against the
                     currently open project, then import or export changes.
                ═══════════════════════════════════════════════════════ -->
                <TabItem Header="{DynamicResource S.MetafileCompare}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Background="#2D2D2D" Padding="6,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="{DynamicResource S.Browse}"
                                            Command="{Binding MetaFileDiffVM.BrowseMetaFile}"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Margin="4,2" Padding="10,5" FontSize="{StaticResource FsBody}"/>
                                    <Button Content="{DynamicResource S.SelectChanged}"
                                            Command="{Binding MetaFileDiffVM.SelectAllChanged}"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Margin="4,2" Padding="10,5" FontSize="{StaticResource FsBody}"/>
                                    <Button Content="{DynamicResource S.DeselectAll}"
                                            Command="{Binding MetaFileDiffVM.DeselectAll}"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Margin="4,2" Padding="10,5" FontSize="{StaticResource FsBody}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding MetaFileDiffVM.DropZoneMessage}"
                                           Foreground="#AAAAAA" FontSize="{StaticResource FsBody}"
                                           VerticalAlignment="Center" Margin="12,0"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="{DynamicResource S.ImportSelected}"
                                            Command="{Binding MetaFileDiffVM.ImportSelected}"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Margin="4,2" Padding="10,5" FontSize="{StaticResource FsBody}"/>
                                    <Button Content="{DynamicResource S.ExportSyncPackage}"
                                            Command="{Binding MetaFileDiffVM.ExportSyncPackage}"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Margin="4,2" Padding="10,5" FontSize="{StaticResource FsBody}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Summary bar -->
                        <Border Grid.Row="1" Background="#F5F5F5"
                                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1"
                                Padding="10,4">
                            <TextBlock FontSize="{StaticResource FsBody}" Foreground="#555555">
                                <Run Text="{Binding MetaFileDiffVM.TotalCount, StringFormat='{}{0} files changed', Mode=OneWay}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding MetaFileDiffVM.AddedCount,    StringFormat='{}{0} in metafile only', Mode=OneWay}" Foreground="#388E3C" FontWeight="SemiBold"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding MetaFileDiffVM.ModifiedCount, StringFormat='{}{0} modified',         Mode=OneWay}" Foreground="#F57F17" FontWeight="SemiBold"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding MetaFileDiffVM.DeletedCount,  StringFormat='{}{0} in current only',  Mode=OneWay}" Foreground="#C62828" FontWeight="SemiBold"/>
                            </TextBlock>
                        </Border>

                        <!-- Content area: drop zone (before load) / diff grid (after load) -->
                        <Grid Grid.Row="2">

                            <!-- Drop zone — visible until a metafile is loaded -->
                            <Border x:Name="MetaFileDropZone"
                                    AllowDrop="True"
                                    Drop="MetaFileDropZone_Drop"
                                    DragOver="MetaFileDropZone_DragOver"
                                    Background="#F9F9F9"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="2"
                                    CornerRadius="6"
                                    Margin="20"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MetaFileDiffVM.IsMetaFileLoaded}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⬇" FontSize="48" HorizontalAlignment="Center" Foreground="#CCCCCC"/>
                                    <TextBlock Text="{DynamicResource S.DropVersionLogHere}"
                                               FontSize="{StaticResource FsTitle}" HorizontalAlignment="Center"
                                               Foreground="#888888" Margin="0,8,0,4"/>
                                    <TextBlock Text="{DynamicResource S.OrUseBrowse}"
                                               FontSize="{StaticResource FsBody}" HorizontalAlignment="Center"
                                               Foreground="#AAAAAA"/>
                                </StackPanel>
                            </Border>

                            <!-- Diff DataGrid — visible once a metafile is loaded -->
                            <DataGrid x:Name="MetaFileDiffGrid"
                                      ItemsSource="{Binding MetaFileDiffVM.DiffItems}"
                                      BorderBrush="#CDCDCD"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      ScrollViewer.CanContentScroll="True"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Style>
                                    <Style TargetType="DataGrid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding MetaFileDiffVM.IsMetaFileLoaded}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Style>
                                <DataGrid.Columns>
                                    <!-- Checkbox -->
                                    <DataGridCheckBoxColumn Header="✓"
                                                            Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="30"/>
                                    <!-- State pill -->
                                    <DataGridTemplateColumn Header="" Width="32">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="3" Padding="3,1" Margin="1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#9E9E9E"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Added">
                                                                    <Setter Property="Background" Value="{StaticResource BrPillAdded}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Modified">
                                                                    <Setter Property="Background" Value="{StaticResource BrPillModified}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Deleted">
                                                                    <Setter Property="Background" Value="{StaticResource BrPillDeleted}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource PillTextStyle}">
                                                                <Setter Property="Text" Value="?"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Added">
                                                                        <Setter Property="Text" Value="+"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Modified">
                                                                        <Setter Property="Text" Value="~"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Deleted">
                                                                        <Setter Property="Text" Value="−"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{StaticResource S.ColFilename}"        Binding="{Binding FileName}"        Width="1.5*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{StaticResource S.ColRelativePath}"   Binding="{Binding RelPath}"         Width="3*"   IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{StaticResource S.ColMetafileBuild}"  Binding="{Binding SrcBuildVersion}" Width="1.5*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{StaticResource S.ColCurrentBuild}"   Binding="{Binding DstBuildVersion}" Width="1.5*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{StaticResource S.ColMetafileHash}"   Binding="{Binding SrcHash}"         Width="0.5*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{StaticResource S.ColCurrentHash}"    Binding="{Binding DstHash}"         Width="0.5*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Added">
                                                <Setter Property="Background" Value="{StaticResource BrAdded}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Modified">
                                                <Setter Property="Background" Value="{StaticResource BrModified}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Deleted">
                                                <Setter Property="Background" Value="{StaticResource BrDeleted}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="#E0E0E0"/>

            <!-- RIGHT: Staged Changes (top) + Action Panel (bottom) -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0.4*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="0.6*"/>
                </Grid.RowDefinitions>

                <!-- Staged / Pre-staged changes -->
                <DockPanel Grid.Row="2">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Style="{StaticResource HeaderLabelStyle}" Margin="0" Text="{DynamicResource S.StagedChanges}"/>
                    </Border>
                    <ListView x:Name="uploadWindow"
                              ItemsSource="{Binding FileTrackVM.ChangedFileList}"
                              SelectedItem="{Binding FileTrackVM.SelectedItem, UpdateSourceTrigger=PropertyChanged}"
                              Tag="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
                              BorderBrush="#CDCDCD"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="{StaticResource S.ColName}"    DisplayMemberBinding="{Binding DataName}"    Width="80"/>
                                <GridViewColumn Header="{StaticResource S.ColBuildV}" DisplayMemberBinding="{Binding VersionDisplay}" Width="60"/>
                                <GridViewColumn Header="{StaticResource S.ColPath}"    DisplayMemberBinding="{Binding DataRelPath}" Width="110"/>
                                <GridViewColumn Header="{StaticResource S.ColState}"   DisplayMemberBinding="{Binding DataState}"   Width="70"/>
                            </GridView>
                        </ListView.View>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Added">
                                        <Setter Property="Background" Value="#BBDEFB"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Restored">
                                        <Setter Property="Background" Value="#FFF9C4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Modified">
                                        <Setter Property="Background" Value="#C8E6C9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataState, Converter={StaticResource DataStateChangeKindConverter}}" Value="Deleted">
                                        <Setter Property="Background" Value="#FFCDD2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{DynamicResource S.Revert}"
                                          Command="{Binding FileTrackVM.RevertChange}"/>
                                <MenuItem Header="{DynamicResource S.RevertAll}"
                                          Command="{Binding FileTrackVM.RevertAllChanges}"/>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Row="1"
                              Height="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="#E0E0E0"/>

                <!-- Action Panel: updater / log / buttons -->
                <DockPanel Grid.Row="0">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeaderStyle}">
                        <TextBlock Style="{StaticResource HeaderLabelStyle}" Margin="0" Text="{DynamicResource S.Actions}"/>
                    </Border>
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Updater name -->
                        <Grid Grid.Row="0" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="0" Content="{DynamicResource S.Updater}" FontSize="{StaticResource FsBody}" Padding="2"/>
                            <TextBox Grid.Column="1" FontSize="{StaticResource FsBody}"
                                     Text="{Binding MetaDataVM.UpdaterName}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                        </Grid>

                        <!-- Update log -->
                        <Grid Grid.Row="1" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label  Grid.Column="0" Content="{DynamicResource S.Log}" FontSize="{StaticResource FsBody}" Padding="2"/>
                            <TextBox Grid.Column="1" FontSize="{StaticResource FsBody}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Text="{Binding MetaDataVM.UpdateLog}"
                                     MaxHeight="52"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                        <!-- Action buttons -->
                        <UniformGrid Grid.Row="2" Columns="2" Margin="0,4,0,0">
                            <Button Content="{DynamicResource S.Clear}"
                                    Margin="2" Height="30" FontSize="{StaticResource FsBody}"
                                    Command="{Binding FileTrackVM.ClearNewfiles}"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="{DynamicResource S.Refresh}"
                                    Margin="2" Height="30" FontSize="{StaticResource FsBody}"
                                    Command="{Binding FileTrackVM.RefreshDeployFileList}"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="{DynamicResource S.Stage}"
                                    Margin="2" Height="30" FontSize="{StaticResource FsBody}"
                                    Command="{Binding FileTrackVM.StageChanges}"
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Button Content="{DynamicResource S.Deploy}"
                                    Margin="2" Height="30" FontSize="{StaticResource FsBody}"
                                    Command="{Binding MetaDataVM.ConductUpdate}"
                                    Style="{StaticResource DeployButtonStyle}"/>
                        </UniformGrid>

                    </Grid>
                </DockPanel>
            </Grid>
        </Grid>


        <!-- Busy overlay: commands are already state-gated; this makes the lock visible
             and absorbs clicks while any operation runs. -->
        <Grid Grid.RowSpan="3"
              Background="#66000000"
              Visibility="{Binding MetaDataVM.IsBusy, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#BDBDBD" BorderThickness="1"
                    CornerRadius="6" Padding="24,18" MinWidth="440" MaxWidth="560">
                <StackPanel>
                    <TextBlock Text="{Binding MetaDataVM.BusyTitle}"
                               FontSize="{StaticResource FsTitle}" FontWeight="SemiBold" Foreground="#212121"/>
                    <ProgressBar Height="8" Margin="0,12,0,4"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding MetaDataVM.BusyProgress, Mode=OneWay}"
                                 IsIndeterminate="{Binding MetaDataVM.BusyIndeterminate}"/>
                    <TextBlock Text="{Binding MetaDataVM.BusyCountText}"
                               Typography.NumeralAlignment="Tabular"
                               FontSize="{StaticResource FsBody}" Foreground="#616161"/>
                    <Border Margin="0,10,0,0" Background="#FAFAFA"
                            BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding MetaDataVM.BusyIndeterminate, Converter={StaticResource InverseBoolToVis}}">
                        <ScrollViewer x:Name="BusyLogScroll" Height="150"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding MetaDataVM.BusyLog}" Margin="8,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OutcomeLabel}"
                                                       FontSize="{StaticResource FsCaption}" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9E9E9E"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="Modified">
                                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="Added">
                                                                <Setter Property="Foreground" Value="#388E3C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="Deleted">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="HashFailed">
                                                                <Setter Property="Foreground" Value="#C62828"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Outcome}" Value="MetadataFallback">
                                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="{StaticResource FsCaption}"
                                                       Foreground="#616161" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="{DynamicResource S.Ovl.Disabled}"
                               FontSize="{StaticResource FsCaption}" Foreground="#9E9E9E" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
