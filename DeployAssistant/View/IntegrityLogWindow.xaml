<Window x:Class="DeployAssistant.View.IntegrityLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeployAssistant.View"
        mc:Ignorable="d"
        Title="{DynamicResource S.Win.IntegrityLog}"
        Height="640" Width="1100"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FAFAFA">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Verdict banner: the decision first, top-left -->
        <Border Grid.Row="0" CornerRadius="4" Padding="14,10" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#FDF3E0"/>
                    <Setter Property="BorderBrush" Value="#F0C179"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsClean}" Value="True">
                            <Setter Property="Background" Value="#E7F2E7"/>
                            <Setter Property="BorderBrush" Value="#9CCC9C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsIntegrityResult}" Value="False">
                            <Setter Property="Background" Value="#EDF1F5"/>
                            <Setter Property="BorderBrush" Value="#B9C6D2"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{DynamicResource S.ExportToXLSX}"
                            Command="{Binding ExportToXLSX}"
                            Style="{StaticResource ActionButtonStyle}"
                            Padding="10,3" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding VerdictText}" FontSize="{StaticResource FsTitle}" FontWeight="SemiBold"
                               Foreground="#212121" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <TextBlock Text="{Binding SubtitleText}" FontSize="{StaticResource FsBody}" Foreground="#616161" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tally chips + filter + revert-all (integrity mode only) -->
        <DockPanel Grid.Row="1" Margin="0,10,0,8"
                   Visibility="{Binding IsIntegrityResult, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right"
                    Content="{DynamicResource S.RevertAll}"
                    Command="{Binding RevertAllRows}"
                    Style="{StaticResource ActionButtonStyle}"
                    Padding="10,3" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"/>
            <TextBox x:Name="FileFilterKeyword" DockPanel.Dock="Right"
                     Width="180" Margin="8,0" FontSize="{StaticResource FsBody}" VerticalAlignment="Center"
                     BorderBrush="#D0D0D0"
                     TextChanged="FileFilterKeyword_TextChanged"/>
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="ChipModified" Style="{StaticResource TallyChipStyle}" Foreground="#F57F17"
                              Checked="Chip_Changed" Unchecked="Chip_Changed">
                    <TextBlock><Run Text="{DynamicResource S.Ovl.OutModified}"/><Run Text=" "/><Run Text="{Binding CountModified, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ChipAdded" Style="{StaticResource TallyChipStyle}" Foreground="#388E3C"
                              Checked="Chip_Changed" Unchecked="Chip_Changed">
                    <TextBlock><Run Text="{DynamicResource S.Ovl.OutAdded}"/><Run Text=" "/><Run Text="{Binding CountAdded, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                </ToggleButton>
                <ToggleButton x:Name="ChipDeleted" Style="{StaticResource TallyChipStyle}" Foreground="#C62828"
                              Checked="Chip_Changed" Unchecked="Chip_Changed">
                    <TextBlock><Run Text="{DynamicResource S.Ovl.OutDeleted}"/><Run Text=" "/><Run Text="{Binding CountDeleted, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                </ToggleButton>
                <Border Style="{StaticResource TallyInfoStyle}" ToolTip="{DynamicResource S.Ig.HashInfo}">
                    <TextBlock FontSize="{StaticResource FsCaption}" Foreground="#9E9E9E">
                        <Run Text="{DynamicResource S.Ovl.OutHashFailed}"/><Run Text=" "/><Run Text="{Binding CountHashFailed, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{DynamicResource S.Ovl.OutMetadata}"/><Run Text=" "/><Run Text="{Binding CountMetadataFallback, Mode=OneWay}"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </DockPanel>

        <!-- Date-grouped results -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3">
            <ListView x:Name="ResultList"
                      ItemsSource="{Binding Rows}"
                      BorderThickness="0"
                      FontSize="{StaticResource FsBody}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="8,4">
                                    <TextBlock FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#424242">
                                        <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text="{DynamicResource S.Ig.GroupCountSuffix}"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="{StaticResource S.ColFilename}" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{StaticResource S.ColRelativePath}" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RelPath}" Foreground="#757575" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{StaticResource S.ColState}" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OutcomeLabel}" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#F57F17"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="Added">
                                                        <Setter Property="Foreground" Value="#388E3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="Deleted">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Outcome}" Value="HashFailed">
                                                        <Setter Property="Foreground" Value="#C62828"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{StaticResource S.Ig.ColOrigin}" Width="60">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Badge}" Foreground="#616161"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{StaticResource S.Ig.ColTime}" Width="55">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Time}" Typography.NumeralAlignment="Tabular" Foreground="#9E9E9E"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{StaticResource S.ColPrevV}" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PrevVersion}" Foreground="#757575" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{StaticResource S.ColBuildV}" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CurrVersion}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{DynamicResource S.Revert}"
                                            Command="{Binding DataContext.RevertRow, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding DataContext.IsIntegrityResult, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource BoolToVis}}"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Padding="8,1" FontSize="{StaticResource FsCaption}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <!-- Raw log behind progressive disclosure -->
        <Expander Grid.Row="3" Margin="0,8,0,0" Header="{DynamicResource S.Ig.RawLog}" FontSize="{StaticResource FsBody}">
            <Border Background="#FFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="3" MaxHeight="180" Margin="0,4,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBox Text="{Binding ChangeLog, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                             FontFamily="Consolas" FontSize="{StaticResource FsCaption}" TextWrapping="NoWrap" Padding="6"/>
                </ScrollViewer>
            </Border>
        </Expander>
    </Grid>
</Window>
