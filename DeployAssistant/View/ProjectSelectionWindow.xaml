<Window x:Class="DeployAssistant.View.ProjectSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Project"
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource DarkWindowStyle}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Select a previously configured project:" 
                   Foreground="White" FontSize="14" Margin="0,0,0,10"/>

        <!-- Project List -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Projects}" 
                  SelectedItem="{Binding SelectedProject}"
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False" 
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CellEditEnding="DataGrid_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Last Accessed (UTC)" Binding="{Binding LastAccessedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" IsReadOnly="True" />
            </DataGrid.Columns>
            <DataGrid.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenCommand}"/>
            </DataGrid.InputBindings>
        </DataGrid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Browse for path..." Command="{Binding BrowseCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Width="130"/>
            <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0" Width="80"/>
            <Button Content="Open" Command="{Binding OpenCommand}" Style="{StaticResource ActionButtonStyle}" Width="80" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>