<Window x:Class="DeployAssistant.View.VersionDeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeployAssistant.View"
        mc:Ignorable="d"
        Title="{DynamicResource S.Win.DeleteVersion}"
        Height="460" Width="680"
        MinHeight="380" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeadlineText"
                   FontSize="{StaticResource FsTitle}" FontWeight="Bold"
                   Foreground="#C62828"
                   TextWrapping="Wrap"/>

        <TextBlock Grid.Row="1"
                   x:Name="WarningText"
                   Margin="0,6,0,10"
                   FontSize="{StaticResource FsBody}" Foreground="#555555"
                   TextWrapping="Wrap"/>

        <!-- What the delete costs -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="3" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource S.Del.DiskReclaimed}"  FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#555555" Margin="0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ReclaimableText"     FontSize="{StaticResource FsBody}" Margin="0,2"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource S.Del.BackupRemoved}"  FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#555555" Margin="0,2"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ExclusiveText"       FontSize="{StaticResource FsBody}" Margin="0,2"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource S.Del.Relocated}" FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#555555" Margin="0,2"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RelocationText"      FontSize="{StaticResource FsBody}" Margin="0,2"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource S.Del.SharedKept}"     FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#555555" Margin="0,2"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SharedText"          FontSize="{StaticResource FsBody}" Margin="0,2"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource S.Del.BackupFolder}"         FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#555555" Margin="0,2"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="BackupFolderText"    FontSize="{StaticResource FsBody}" Margin="0,2"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </Grid>
        </Border>

        <!-- Blockers — populated only when the delete is refused -->
        <Border Grid.Row="3"
                x:Name="BlockerPanel"
                Visibility="Collapsed"
                Margin="0,10,0,0"
                Background="#FFF3E0"
                BorderBrush="#F57C00" BorderThickness="1" CornerRadius="3"
                Padding="10,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{DynamicResource S.Del.CannotDelete}"
                           FontSize="{StaticResource FsBody}" FontWeight="SemiBold" Foreground="#E65100"
                           Margin="0,0,0,4"/>
                <ItemsControl x:Name="BlockerList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="{StaticResource FsBody}" Foreground="#555555"
                                       TextWrapping="Wrap" Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <!-- Destructive: deliberately NOT the default button. -->
            <Button x:Name="DeleteButton"
                    Click="Delete_Click"
                    MinWidth="180" Height="30" Margin="0,0,8,0"
                    FontSize="{StaticResource FsBody}"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button x:Name="CancelButton"
                    Content="{DynamicResource S.Cancel}"
                    IsCancel="True" IsDefault="True"
                    MinWidth="100" Height="30"
                    FontSize="{StaticResource FsBody}"
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
